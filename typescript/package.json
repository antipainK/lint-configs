{
  "name": "@antipain/eslint-config",
  "version": "0.0.3",
  "description": "Antipain's shared ESLint configuration for modern TypeScript & JavaScript projects",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antipainK/lint-configs.git",
    "directory": "typescript"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "config",
    "lint",
    "typescript",
    "javascript",
    "flat-config"
  ],
  "author": "Antipain",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "eslint": ">=8.57.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "node --test test/config.test.mjs",
    "prepublishOnly": "pnpm run lint && pnpm run test"
  },
  "dependencies": {
    "@eslint/css": "^2.0.0",
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.71.0"
  },
  "devDependencies": {
    "eslint": "^10.11.0"
  }
}